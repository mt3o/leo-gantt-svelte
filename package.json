{
  "name": "leo-gantt-svelte5",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig tsconfig.json",
    "build": "tsc --noEmit && vite build && tsc --declaration --emitDeclarationOnly --outDir dist --declarationMap true",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest --browser.enabled=true",
    "test:e2e:ui": "vitest --ui --browser.enabled=true"
  },
  "files": [
    "dist",
    "!dist/index.html",
    "!dist/assets"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/svelte-gantt.es.js",
      "default": "./dist/svelte-gantt.umd.js"
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/lib/index.d.ts",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^22",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "^4.0.18",
    "jsdom": "^28.0.0",
    "playwright": "^1.58.2",
    "svelte": "^5.50.1",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18",
    "vitest-browser-svelte": "^2.0.2"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}

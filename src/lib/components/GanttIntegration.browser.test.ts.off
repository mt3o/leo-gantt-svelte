import { render } from '@testing-library/svelte';
import { expect, test, describe, vi } from 'vitest';
import { userEvent } from '@vitest/browser/context';
import App from '../../App.svelte';

describe('Gantt Integration Tests', () => {
  test('expanding a group increases the number of visible rows', async () => {
    const { getByText, getAllByRole, queryByText } = render(App);

    // 1. Check initial state: Should see "Group R-0-0" but not its children yet
    // (Assuming children start collapsed in App.svelte logic)
    const groupLabel = getByText(/Group R-0-0/i);
    expect(groupLabel).toBeInViewport();

    const initialRows = getAllByRole('button', { name: /▶/ }).length;

    // 2. Click the expand button (the arrow)
    const expandButton = getAllByRole('button').find(btn => btn.textContent?.includes('▶'));
    if (!expandButton) throw new Error("Expand button not found");

    await userEvent.click(expandButton);

    // 3. Verify reactivity: After expansion, more rows should exist in the DOM
    // because the tree-walker updated the flattened list
    const updatedRows = getAllByRole('button').length;
    expect(updatedRows).toBeGreaterThan(initialRows);

    // Check if a child resource is now visible
    const childResource = getByText(/Resource R-0-0-0/i);
    expect(childResource).toBeInViewport();
  });

  test('zooming changes the time range labels in the header', async () => {
    const { getByTestId, getAllByText } = render(App);

    const svg = getByTestId('gantt-svg');
    const initialTicks = getAllByText(/[A-Z][a-z]{2} \d+/).map(el => el.textContent);

    // Simulate Ctrl + Scroll Up to zoom in
    await userEvent.fill(svg, '', {
      initialSelectionStart: 0,
      initialSelectionEnd: 0,
    }); // Focus the area

    // We trigger the wheel event directly on the container
    const wheelEvent = new WheelEvent('wheel', {
      deltaY: -100,
      ctrlKey: true,
      bubbles: true,
      clientX: 500,
      clientY: 500
    });

    svg.dispatchEvent(wheelEvent);

    // The header should re-render with different/more granular ticks
    // (or shifted positions) due to the viewStart/viewEnd state change
    const newTicks = getAllByText(/[A-Z][a-z]{2} \d+/).map(el => el.textContent);

    // While the text might be similar, the math in viewport.ts
    // and the resulting x positions in Header.svelte have changed
    expect(newTicks).not.toEqual(initialTicks);
  });
});
